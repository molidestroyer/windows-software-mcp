<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SoftwareDock.App.ViewModels"
        x:Class="SoftwareDock.App.Shell.DockWindow"
        x:DataType="vm:DockViewModel"
        Title="Software Dock"
        Icon="avares://SoftwareDock/Assets/app.ico"
        Width="420" Height="760"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        Background="Transparent">

  <Border Classes="panel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

      <!-- Header: also the drag handle when the dock floats -->
      <Border x:Name="Header" Grid.Row="0" Background="{StaticResource HeaderGlowBrush}" Padding="18,16,12,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Image Source="avares://SoftwareDock/Assets/app.png" Width="36" Height="36" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="title" Text="Software" />
            <TextBlock Classes="caption" Text="{Binding Summary}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
            <Button Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
              <PathIcon Data="{StaticResource IconRefresh}" />
            </Button>
            <Button Classes="icon" Command="{Binding TogglePinCommand}" ToolTip.Tip="Pin to the right edge / float">
              <Panel>
                <PathIcon Data="{StaticResource IconWindow}" IsVisible="{Binding IsPinned}" />
                <PathIcon Data="{StaticResource IconPin}" IsVisible="{Binding !IsPinned}" />
              </Panel>
            </Button>
            <Button Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="Hide (Esc)">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Search -->
      <Panel Grid.Row="1" Margin="16,4,16,10">
        <TextBox x:Name="SearchBox" Classes="search" Text="{Binding SearchText}" PlaceholderText="{Binding SearchWatermark}" />
        <PathIcon Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="14,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
      </Panel>

      <!-- Sections -->
      <Grid Grid.Row="2" Margin="16,0,16,8" ColumnDefinitions="Auto,Auto,Auto,*">
        <RadioButton Grid.Column="0" Classes="tab" GroupName="section" IsChecked="{Binding IsInstalledSection}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Installed" VerticalAlignment="Center" />
            <Border Classes="count"><TextBlock Text="{Binding InstalledCount}" /></Border>
          </StackPanel>
        </RadioButton>
        <RadioButton Grid.Column="1" Classes="tab" GroupName="section" IsChecked="{Binding IsUpdatesSection}" Margin="4,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Updates" VerticalAlignment="Center" />
            <Border Classes="count warn" IsVisible="{Binding HasUpdates}"><TextBlock Text="{Binding UpdateCount}" /></Border>
          </StackPanel>
        </RadioButton>
        <RadioButton Grid.Column="2" Classes="tab" GroupName="section" IsChecked="{Binding IsDiscoverSection}" Margin="4,0,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconSparkle}" Width="12" Height="12" />
            <TextBlock Text="Discover" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </Grid>

      <ProgressBar Grid.Row="3" Classes="activity" IsIndeterminate="True" IsVisible="{Binding IsActivityVisible}" Margin="16,0" />

      <!-- Lists -->
      <Panel Grid.Row="4">
        <DockPanel IsVisible="{Binding !IsDiscoverSection}">
          <Border DockPanel.Dock="Top" IsVisible="{Binding ShowUpdateAll}" Margin="16,8,16,2" Padding="12,8"
                  CornerRadius="12" Background="{StaticResource UpdateSoftBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding UpdateBanner}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"
                         Foreground="{StaticResource UpdateBrush}" />
              <Button Grid.Column="1" Classes="action update" Background="#33F59E0B" Command="{Binding UpgradeAllCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconArrowUp}" />
                  <TextBlock Text="Update all" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        <ScrollViewer Padding="10,6,10,6">
          <ItemsControl ItemsSource="{Binding Applications}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ApplicationItemViewModel">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="avatar" Background="{Binding AvatarBrush}" VerticalAlignment="Top">
                      <Panel>
                        <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasIcon}" />
                        <Border Background="#F2FFFFFF" IsVisible="{Binding HasIcon}">
                          <Image Source="{Binding Icon}" Width="26" Height="26" />
                        </Border>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <TextBlock Classes="name" Text="{Binding Name}" />
                      <TextBlock Classes="meta" Text="{Binding Subtitle}" />
                      <Border Classes="badge" IsVisible="{Binding HasUpdate}">
                        <TextBlock Text="{Binding UpdateText}" />
                      </Border>
                    </StackPanel>
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowActions}">
                        <Button Classes="action update" IsVisible="{Binding ShowUpgrade}" Command="{Binding UpgradeCommand}" ToolTip.Tip="Update">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource IconArrowUp}" />
                            <TextBlock Text="Update" />
                          </StackPanel>
                        </Button>
                        <Button Classes="action ghost" Padding="0" Width="30" IsVisible="{Binding ShowUninstall}" Command="{Binding RequestUninstallCommand}" ToolTip.Tip="Uninstall">
                          <PathIcon Data="{StaticResource IconTrash}" />
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsConfirmingUninstall}">
                        <Button Classes="action danger" Content="Remove" Command="{Binding ConfirmUninstallCommand}" />
                        <Button Classes="action" Content="Cancel" Command="{Binding CancelUninstallCommand}" />
                      </StackPanel>
                      <ProgressBar IsVisible="{Binding IsWorking}" IsIndeterminate="True" Width="56" Classes="activity" />
                    </Panel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        </DockPanel>

        <ScrollViewer IsVisible="{Binding IsDiscoverSection}" Padding="10,6,10,6">
          <ItemsControl ItemsSource="{Binding CatalogResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CatalogItemViewModel">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="avatar" Background="{Binding AvatarBrush}">
                      <TextBlock Text="{Binding Initials}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <TextBlock Classes="name" Text="{Binding Name}" />
                      <TextBlock Classes="meta" Text="{Binding Subtitle}" />
                    </StackPanel>
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                      <Button Classes="action primary" IsVisible="{Binding ShowInstall}" Command="{Binding InstallCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <PathIcon Data="{StaticResource IconDownload}" />
                          <TextBlock Text="Install" />
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsInstalled}" Margin="0,0,6,0">
                        <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Installed" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                      <ProgressBar IsVisible="{Binding IsWorking}" IsIndeterminate="True" Width="56" Classes="activity" />
                    </Panel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="32">
          <PathIcon Data="{StaticResource IconSparkle}" Width="28" Height="28" Foreground="{StaticResource AccentStart}" />
          <TextBlock Text="{Binding EmptyMessage}" TextAlignment="Center" TextWrapping="Wrap" Classes="caption" />
        </StackPanel>
      </Panel>

      <!-- Status bar -->
      <Border Grid.Row="5" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="18,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="caption" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                     Classes.error="{Binding StatusIsError}" />
          <TextBlock Grid.Column="1" Classes="caption" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                     Text="{Binding HotkeyText}" />
        </Grid>
      </Border>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="TextBlock.caption.error">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
  </Window.Styles>
</Window>
