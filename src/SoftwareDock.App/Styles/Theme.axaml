<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Palette: the indigo → violet of the app icon on a near-black, slightly blue surface. -->
      <Color x:Key="AccentStart">#6366F1</Color>
      <Color x:Key="AccentEnd">#A855F7</Color>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F2121218" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="StrokeBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />
      <SolidColorBrush x:Key="UpdateBrush" Color="#F59E0B" />
      <SolidColorBrush x:Key="UpdateSoftBrush" Color="#26F59E0B" />
      <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
      <LinearGradientBrush x:Key="AccentBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{StaticResource AccentStart}" />
        <GradientStop Offset="1" Color="{StaticResource AccentEnd}" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#336366F1" />
        <GradientStop Offset="0.6" Color="#11A855F7" />
        <GradientStop Offset="1" Color="#00000000" />
      </LinearGradientBrush>

      <!-- Icons: 24×24 geometry, drawn with PathIcon so they follow Foreground. -->
      <StreamGeometry x:Key="IconSearch">M10,2 A8,8 0 1 0 14.9,16.3 L20.3,21.7 21.7,20.3 16.3,14.9 A8,8 0 0 0 10,2 Z M10,4 A6,6 0 1 1 10,16 A6,6 0 1 1 10,4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M12,4 C8.4,4 5.4,6.4 4.4,9.7 L6.3,10.3 C7.1,7.8 9.4,6 12,6 C14,6 15.7,7 16.8,8.5 L14,8.5 14,10.5 20,10.5 20,4.5 18,4.5 18,7 C16.5,5.2 14.4,4 12,4 Z M19.6,13.7 L17.7,13.1 C16.9,15.9 14.6,18 12,18 C10,18 8.3,17 7.2,15.5 L10,15.5 10,13.5 4,13.5 4,19.5 6,19.5 6,17 C7.5,18.8 9.6,20 12,20 C15.6,20 18.6,17.4 19.6,13.7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M5.4,4 L12,10.6 18.6,4 20,5.4 13.4,12 20,18.6 18.6,20 12,13.4 5.4,20 4,18.6 10.6,12 4,5.4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPin">M14.6,2.6 L21.4,9.4 20,10.8 18.9,9.7 15.1,13.5 15.6,17.6 14.2,19 10.3,15.1 4.4,21 3,21 3,19.6 8.9,13.7 5,9.8 6.4,8.4 10.5,8.9 14.3,5.1 13.2,4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconWindow">F1 M3,4 L21,4 21,20 3,20 Z M5,8 L5,18 19,18 19,8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">F1 M9,2 L15,2 15,4 20,4 20,6 4,6 4,4 9,4 Z M5.5,7 L18.5,7 17.5,22 6.5,22 Z M9,9.5 L9,19.5 10.6,19.5 10.6,9.5 Z M13.4,9.5 L13.4,19.5 15,19.5 15,9.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconArrowUp">M12,3 L19.5,10.5 18.1,11.9 13,6.8 13,21 11,21 11,6.8 5.9,11.9 4.5,10.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M11,3 L13,3 13,13.2 16.6,9.6 18,11 12,17 6,11 7.4,9.6 11,13.2 Z M4,19 L20,19 20,21 4,21 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M9,16.2 L4.8,12 3.4,13.4 9,19 21,7 19.6,5.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSparkle">M12,2 L13.8,8.2 20,10 13.8,11.8 12,18 10.2,11.8 4,10 10.2,8.2 Z M19,15 L19.9,17.1 22,18 19.9,18.9 19,21 18.1,18.9 16,18 18.1,17.1 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">F1 M10.3,2 L13.7,2 14.2,4.6 C14.9,4.9 15.5,5.2 16.1,5.7 L18.6,4.8 20.3,7.8 18.3,9.5 C18.4,9.9 18.4,10.4 18.4,10.8 18.4,11.2 18.4,11.7 18.3,12.1 L20.3,13.8 18.6,16.8 16.1,15.9 C15.5,16.4 14.9,16.7 14.2,17 L13.7,19.6 10.3,19.6 9.8,17 C9.1,16.7 8.5,16.4 7.9,15.9 L5.4,16.8 3.7,13.8 5.7,12.1 C5.6,11.7 5.6,11.2 5.6,10.8 5.6,10.4 5.6,9.9 5.7,9.5 L3.7,7.8 5.4,4.8 7.9,5.7 C8.5,5.2 9.1,4.9 9.8,4.6 Z M12,7.6 A3.2,3.2 0 1 0 12,14 A3.2,3.2 0 1 0 12,7.6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSelect">F1 M4,4 L10,4 10,10 4,10 Z M5.5,5.5 L5.5,8.5 8.5,8.5 8.5,5.5 Z M13,6 L21,6 21,8 13,8 Z M4,14 L10,14 10,20 4,20 Z M13,16 L21,16 21,18 13,18 Z M5.2,16.6 L6.3,15.5 7.2,16.4 9,14.6 10,15.6 7.2,18.4 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBack">M10.6,5 L12,6.4 7.4,11 20,11 20,13 7.4,13 12,17.6 10.6,19 3.6,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBackup">M12,3 C8.1,3 5,4.3 5,6 L5,18 C5,19.7 8.1,21 12,21 C15.9,21 19,19.7 19,18 L19,6 C19,4.3 15.9,3 12,3 Z M12,5 C15.1,5 17,5.9 17,6 C17,6.1 15.1,7 12,7 C8.9,7 7,6.1 7,6 C7,5.9 8.9,5 12,5 Z M7,8.4 C8.3,8.8 10.1,9 12,9 C13.9,9 15.7,8.8 17,8.4 L17,12 C17,12.1 15.1,13 12,13 C8.9,13 7,12.1 7,12 Z M7,14.4 C8.3,14.8 10.1,15 12,15 C13.9,15 15.7,14.8 17,14.4 L17,18 C17,18.1 15.1,19 12,19 C8.9,19 7,18.1 7,18 Z</StreamGeometry>
      <StreamGeometry x:Key="IconAgent">F1 M11,2 L13,2 13,4 17,4 C18.7,4 20,5.3 20,7 L20,16 C20,17.7 18.7,19 17,19 L14,19 12,22 10,19 7,19 C5.3,19 4,17.7 4,16 L4,7 C4,5.3 5.3,4 7,4 L11,4 Z M7,6 C6.4,6 6,6.4 6,7 L6,16 C6,16.6 6.4,17 7,17 L17,17 C17.6,17 18,16.6 18,16 L18,7 C18,6.4 17.6,6 17,6 Z M9,9 A1.5,1.5 0 1 1 9,12 A1.5,1.5 0 1 1 9,9 Z M15,9 A1.5,1.5 0 1 1 15,12 A1.5,1.5 0 1 1 15,9 Z M8.5,14 L15.5,14 15.5,15.5 8.5,15.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRocket">M12,2 C15.5,3.5 18,7.5 18,12 L18,15 20,18 20,20 16,18 8,18 4,20 4,18 6,15 6,12 C6,7.5 8.5,3.5 12,2 Z M12,7.5 A2,2 0 1 0 12,11.5 A2,2 0 1 0 12,7.5 Z M10,19 L14,19 12,22 Z</StreamGeometry>
      <StreamGeometry x:Key="IconShield">F1 M12,2 L20,5 20,11 C20,16 16.6,20.4 12,22 C7.4,20.4 4,16 4,11 L4,5 Z M11,7 L13,7 13,13 11,13 Z M11,15 L13,15 13,17 11,17 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBell">M12,2 C12.8,2 13.5,2.7 13.5,3.5 L13.5,4.2 C16.1,4.9 18,7.2 18,10 L18,15 20,17 20,18 4,18 4,17 6,15 6,10 C6,7.2 7.9,4.9 10.5,4.2 L10.5,3.5 C10.5,2.7 11.2,2 12,2 Z M10,19 L14,19 C14,20.1 13.1,21 12,21 C10.9,21 10,20.1 10,19 Z</StreamGeometry>
      <StreamGeometry x:Key="IconClock">F1 M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 Z M11,6 L13,6 13,11.6 16.5,14.6 15.2,16.1 11,12.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBroom">M18.4,2.2 L19.8,3.6 14.2,9.2 15.5,10.5 C16.3,11.3 16.3,12.6 15.5,13.4 L14.8,14.1 9.9,9.2 10.6,8.5 C11.4,7.7 12.7,7.7 13.5,8.5 L13.8,8.8 Z M9.2,9.9 L14.1,14.8 C13.4,17.6 11.4,20.3 8.5,22 L2,22 C3.7,19.6 4.3,16.4 4.6,14.2 C5.7,12.4 7.4,10.6 9.2,9.9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPower">M11,2 L13,2 13,12 11,12 Z M7.1,5.2 L8.5,6.6 C7,7.8 6,9.8 6,12 C6,15.3 8.7,18 12,18 C15.3,18 18,15.3 18,12 C18,9.8 17,7.8 15.5,6.6 L16.9,5.2 C18.8,6.8 20,9.3 20,12 C20,16.4 16.4,20 12,20 C7.6,20 4,16.4 4,12 C4,9.3 5.2,6.8 7.1,5.2 Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Panel chrome -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>

  <!-- Square ghost buttons in the header -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.icon:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- Search -->
  <Style Selector="TextBox.search">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="38,0,12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource AccentStart}" />
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>

  <!-- Segmented tabs -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="chip" CornerRadius="8" Padding="10,7" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover /template/ Border#chip">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#chip">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Count pill inside a tab -->
  <Style Selector="Border.count">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.count.warn">
    <Setter Property="Background" Value="{StaticResource UpdateBrush}" />
  </Style>
  <Style Selector="Border.count.warn TextBlock">
    <Setter Property="Foreground" Value="#1C1917" />
  </Style>

  <!-- App rows -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.avatar TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.name">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Background" Value="{StaticResource UpdateSoftBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource UpdateBrush}" />
  </Style>

  <!-- Row actions -->
  <Style Selector="Button.action">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.action PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>
  <Style Selector="Button.action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.update">
    <Setter Property="Background" Value="{StaticResource UpdateSoftBrush}" />
    <Setter Property="Foreground" Value="{StaticResource UpdateBrush}" />
  </Style>
  <Style Selector="Button.update:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#40F59E0B" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#DC2626" />
  </Style>

  <Style Selector="ProgressBar.activity">
    <Setter Property="Height" Value="2" />
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Settings cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource AccentStart}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentStart}" />
  </Style>

  <!-- Compact sort picker -->
  <Style Selector="ComboBox.sort">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ToggleButton.chip PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>

  <!-- Running pill -->
  <Style Selector="Border.running">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="5,1,7,1" />
    <Setter Property="Background" Value="#1A22C55E" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Border.running TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#86EFAC" />
  </Style>

  <!-- Security and usage badges -->
  <Style Selector="Border.security">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="5,1,7,1" />
    <Setter Property="Background" Value="#33EF4444" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4,6,0" />
  </Style>
  <Style Selector="Border.security TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#FCA5A5" />
  </Style>
  <Style Selector="Border.muted">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4,6,0" />
  </Style>
  <Style Selector="Border.muted TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
</Styles>
