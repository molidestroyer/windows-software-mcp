<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: Windows toast notifications (WinRT) for an unpackaged app. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>SoftwareDock.App</RootNamespace>
    <AssemblyName>SoftwareDock</AssemblyName>
    <Description>Tray app: a dock panel to browse, update, install and remove the software on this PC.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- LibraryImport source generation for the Win32 hotkey window. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoftwareDock.Infrastructure\SoftwareDock.Infrastructure.csproj" />
    <!-- Ships the MCP server next to the dock, so "Copy MCP config" points at a binary that exists. -->
    <ProjectReference Include="..\SoftwareDock.Mcp\SoftwareDock.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SoftwareDock.App.Tests" />
  </ItemGroup>
</Project>
